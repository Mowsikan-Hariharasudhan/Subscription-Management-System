// Brightloop — Database Schema (SQLite + Prisma ORM)
// Integer Paise (paise = 1/100 INR) for all monetary columns. Zero float arithmetic.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("CUSTOMER") // ADMIN, STAFF, CUSTOMER
  customerId   String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
}

model Customer {
  id             String         @id @default(cuid())
  code           String         @unique // e.g. CUS-001
  name           String
  email          String         @unique
  phone          String?
  company        String
  gstin          String?
  address        String?
  city           String?
  status         String         @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subscriptions  Subscription[]
  invoices       Invoice[]
  quotations     Quotation[]
}

model Product {
  id          String           @id @default(cuid())
  code        String           @unique // e.g. PRD-001
  name        String
  type        String           @default("Software")
  salesPrice  Int              // Integer paise (e.g. 200000 = ₹2,000.00)
  costPrice   Int              // Integer paise
  description String?
  notes       String?
  status      String           @default("ACTIVE") // ACTIVE, ARCHIVED (Archive, do not delete)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
  plans       Plan[]
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String   // e.g. "Odoo Brand"
  priceDelta Int      // Additive price in paise (e.g. 56000 = +₹560.00)
  isActive   Boolean  @default(true)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Plan {
  id              String         @id @default(cuid())
  code            String         @unique // e.g. PLN-001
  productId       String
  name            String
  price           Int            // Integer paise
  billingCycle    String         @default("MONTHLY") // DAILY, WEEKLY, MONTHLY, YEARLY
  minQty          Int            @default(1)
  allowPause      Boolean        @default(true)
  allowRenew      Boolean        @default(true)
  allowEarlyClose Boolean        @default(true)
  autoClose       Boolean        @default(false)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  product         Product        @relation(fields: [productId], references: [id])
  subscriptions   Subscription[]
}

model TaxRule {
  id                 String   @id @default(cuid())
  name               String   // e.g. "GST 18%"
  rate               Float    // e.g. 18.0
  type               String   @default("IGST") // IGST, CGST_SGST
  applicableProducts String?  // JSON string array of product IDs or null for global
  effectiveFrom      DateTime @default(now())
  effectiveTo        DateTime
  isActive           Boolean  @default(true)
}

model Discount {
  id          String   @id @default(cuid())
  name        String
  type        String   // FIXED (paise) or PERCENT
  value       Int      // Paise if FIXED, percentage integer if PERCENT
  minQty      Int      @default(1)
  minPurchase Int      @default(0) // Paise
  maxUses     Int      @default(100)
  usedCount   Int      @default(0)
  scope       String   @default("SUBSCRIPTION") // SUBSCRIPTION, PRODUCTS
  productIds  String?  // JSON string array
  startsAt    DateTime @default(now())
  endsAt      DateTime
  isActive    Boolean  @default(true)
}

model Quotation {
  id         String   @id @default(cuid())
  number     String   @unique // e.g. QTN-2026-0001
  customerId String
  state      String   @default("DRAFT") // DRAFT, QUOTATION, CONFIRMED, ACTIVE
  lines      String   // JSON string of quotation lines
  total      Int      // Integer paise
  validUntil DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Subscription {
  id              String    @id @default(cuid())
  code            String    @unique // e.g. SUB-2026-000001
  customerId      String
  planId          String
  state           String    @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, CLOSED, EXPIRED
  startDate       DateTime  @default(now())
  expiryDate      DateTime
  nextBillingDate DateTime
  lines           String?   // JSON representation of configured product lines
  total           Int       // Recurring charge in paise
  mrr             Int       // Monthly recurring revenue normalized in paise
  pausedAt        DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customer        Customer  @relation(fields: [customerId], references: [id])
  plan            Plan      @relation(fields: [planId], references: [id])
  invoices        Invoice[]
}

model Invoice {
  id             String    @id @default(cuid())
  code           String    @unique // e.g. INV-2026-000001
  subscriptionId String
  customerId     String
  state          String    @default("DRAFT") // DRAFT, CONFIRMED, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  periodStart    DateTime
  periodEnd      DateTime
  issueDate      DateTime  @default(now())
  dueDate        DateTime
  subtotal       Int       // Integer paise
  taxTotal       Int       // Integer paise
  discountTotal  Int       @default(0) // Integer paise
  total          Int       // Integer paise
  amountPaid     Int       @default(0) // Integer paise
  lines          String?   // JSON lines
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  customer       Customer     @relation(fields: [customerId], references: [id])
  payments       Payment[]

  // Non-negotiable anti-double-billing idempotency lock
  @@unique([subscriptionId, periodStart, periodEnd], name: "subscription_billing_period_unique")
}

model Payment {
  id        String   @id @default(cuid())
  number    String   @unique // e.g. PAY-2026-000001
  invoiceId String
  amount    Int      // Integer paise
  method    String   // CASH, UPI, CARD, BANK_TRANSFER, OTHER
  reference String
  paidAt    DateTime @default(now())
  notes     String?
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  changes   String?  // JSON string representation of before/after
  createdAt DateTime @default(now())
}

model Settings {
  id          Int      @id @default(1)
  companyName String   @default("Brightloop Software Systems Pvt Ltd")
  gstin       String   @default("33AAACB9876Z1Z8")
  currency    String   @default("INR")
  billingCron String   @default("0 0 * * *")
  updatedAt   DateTime @updatedAt
}
